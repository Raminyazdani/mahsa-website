{
  "name": "mahsa-website-final",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "content:generate": "node scripts/generate-content.ts",
    "content:check": "node scripts/check-content.ts",
    "cv:preview": "node scripts/cv-preview.ts",
    "cv:pdf": "node scripts/cv-pdf.ts",
    "cv:expectations": "node scripts/export-cv-expectations.ts",
    "cv:verify": "node scripts/run-cv-verifier.ts",
    "cv:stamp": "node scripts/stamp-cv-pdfs.ts",
    "typecheck": "npm run content:generate && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/build.ts",
    "dev": "node scripts/serve.ts --dev",
    "preview": "node scripts/serve.ts",
    "check": "npm run typecheck && npm test && npm run content:check && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
